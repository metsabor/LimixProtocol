<Window xmlns='http://schemas.microsoft.com/winfx/2006/xaml/presentation'
        xmlns:x='http://schemas.microsoft.com/winfx/2006/xaml'
        xmlns:shell='clr-namespace:System.Windows.Shell;assembly=PresentationFramework'
        Title='LimixProtocol' Width='1060' Height='720' ResizeMode='CanMinimize'
        WindowStartupLocation='CenterScreen' Background='{DynamicResource Bg}'
        FontFamily='Segoe UI Variable Text, Segoe UI' FontSize='13'
        TextElement.Foreground='{DynamicResource Tx}' UseLayoutRounding='True' SnapsToDevicePixels='True'>

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight='40' ResizeBorderThickness='0' GlassFrameThickness='0' CornerRadius='0' UseAeroCaptionButtons='False'/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- Theme brushes: replaced from code when theme / accent changes (DynamicResource = no flicker) -->
    <SolidColorBrush x:Key='Bg' Color='#0E0F11'/>
    <SolidColorBrush x:Key='Sf' Color='#16171A'/>
    <SolidColorBrush x:Key='Sf2' Color='#1E2024'/>
    <SolidColorBrush x:Key='Bd' Color='#2A2D33'/>
    <SolidColorBrush x:Key='Tx' Color='#ECEDEF'/>
    <SolidColorBrush x:Key='Dim' Color='#9498A1'/>
    <SolidColorBrush x:Key='Hv' Color='#272A30'/>
    <SolidColorBrush x:Key='Ac' Color='#E5484D'/>
    <SolidColorBrush x:Key='AcSoft' Color='#2EE5484D'/>
    <SolidColorBrush x:Key='AcFg' Color='#FFFFFF'/>
    <LinearGradientBrush x:Key='CardBg' StartPoint='0,0' EndPoint='1,1'><GradientStop Color='#2AFFFFFF' Offset='0'/><GradientStop Color='#0DFFFFFF' Offset='1'/></LinearGradientBrush>
    <LinearGradientBrush x:Key='CardBd' StartPoint='0,0' EndPoint='1,1'><GradientStop Color='#66FFFFFF' Offset='0'/><GradientStop Color='#14FFFFFF' Offset='0.5'/><GradientStop Color='#38FFFFFF' Offset='1'/></LinearGradientBrush>
    <SolidColorBrush x:Key='SideBg' Color='#0DFFFFFF'/>
    <CornerRadius x:Key='RCard'>14</CornerRadius>
    <CornerRadius x:Key='RCtl'>10</CornerRadius>
    <CornerRadius x:Key='RSm'>8</CornerRadius>
    <CornerRadius x:Key='RTrack'>13</CornerRadius>
    <CornerRadius x:Key='RThumb'>9</CornerRadius>
    <CornerRadius x:Key='RBar'>3</CornerRadius>
    <CornerRadius x:Key='RCap'>14</CornerRadius>
    <CornerRadius x:Key='RFab'>24</CornerRadius>

    <Style x:Key='H1' TargetType='TextBlock'>
      <Setter Property='FontSize' Value='26'/>
      <Setter Property='FontWeight' Value='SemiBold'/>
    </Style>
    <Style x:Key='Sub' TargetType='TextBlock'>
      <Setter Property='Foreground' Value='{DynamicResource Dim}'/>
      <Setter Property='TextWrapping' Value='Wrap'/>
      <Setter Property='Margin' Value='0,4,0,18'/>
    </Style>
    <Style x:Key='Hint' TargetType='TextBlock'>
      <Setter Property='Foreground' Value='{DynamicResource Dim}'/>
      <Setter Property='FontSize' Value='12'/>
      <Setter Property='TextWrapping' Value='Wrap'/>
      <Setter Property='Margin' Value='0,2,18,0'/>
    </Style>
    <Style x:Key='Sec' TargetType='TextBlock'>
      <Setter Property='Foreground' Value='{DynamicResource Ac}'/>
      <Setter Property='FontSize' Value='12'/>
      <Setter Property='FontWeight' Value='Bold'/>
      <Setter Property='Margin' Value='0,0,0,4'/>
    </Style>
    <Style x:Key='Card' TargetType='Border'>
      <Setter Property='Background' Value='{DynamicResource CardBg}'/>
      <Setter Property='BorderBrush' Value='{DynamicResource CardBd}'/>
      <Setter Property='BorderThickness' Value='1'/>
      <Setter Property='CornerRadius' Value='{DynamicResource RCard}'/>
      <Setter Property='Padding' Value='18'/>
    </Style>

    <Style x:Key='Btn' TargetType='Button'>
      <Setter Property='Foreground' Value='{DynamicResource Tx}'/>
      <Setter Property='Cursor' Value='Hand'/>
      <Setter Property='FocusVisualStyle' Value='{x:Null}'/>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='Button'>
            <Border x:Name='bd' Background='{DynamicResource Sf2}' BorderBrush='{DynamicResource Bd}' BorderThickness='1' CornerRadius='{DynamicResource RCtl}' Padding='16,9' RenderTransformOrigin='0.5,0.5'>
              <Border.RenderTransform><ScaleTransform x:Name='sc'/></Border.RenderTransform>
              <ContentPresenter HorizontalAlignment='Center' VerticalAlignment='Center' TextElement.Foreground='{TemplateBinding Foreground}'/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property='IsMouseOver' Value='True'><Setter TargetName='bd' Property='Background' Value='{DynamicResource Hv}'/></Trigger>
              <Trigger Property='IsPressed' Value='True'><Setter TargetName='bd' Property='Opacity' Value='0.85'/><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName='sc' Storyboard.TargetProperty='ScaleX' To='0.95' Duration='0:0:0.08'/><DoubleAnimation Storyboard.TargetName='sc' Storyboard.TargetProperty='ScaleY' To='0.95' Duration='0:0:0.08'/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName='sc' Storyboard.TargetProperty='ScaleX' To='1' Duration='0:0:0.2'/><DoubleAnimation Storyboard.TargetName='sc' Storyboard.TargetProperty='ScaleY' To='1' Duration='0:0:0.2'/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
              <Trigger Property='IsEnabled' Value='False'><Setter TargetName='bd' Property='Opacity' Value='0.45'/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key='BtnP' TargetType='Button'>
      <Setter Property='Foreground' Value='{DynamicResource AcFg}'/>
      <Setter Property='FontWeight' Value='SemiBold'/>
      <Setter Property='Cursor' Value='Hand'/>
      <Setter Property='FocusVisualStyle' Value='{x:Null}'/>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='Button'>
            <Border x:Name='bd' Background='{DynamicResource Ac}' CornerRadius='{DynamicResource RCtl}' Padding='18,9' RenderTransformOrigin='0.5,0.5'>
              <Border.RenderTransform><ScaleTransform x:Name='sc'/></Border.RenderTransform>
              <ContentPresenter HorizontalAlignment='Center' VerticalAlignment='Center' TextElement.Foreground='{TemplateBinding Foreground}'/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property='IsMouseOver' Value='True'><Setter TargetName='bd' Property='Opacity' Value='0.88'/></Trigger>
              <Trigger Property='IsPressed' Value='True'><Setter TargetName='bd' Property='Opacity' Value='0.8'/><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName='sc' Storyboard.TargetProperty='ScaleX' To='0.95' Duration='0:0:0.08'/><DoubleAnimation Storyboard.TargetName='sc' Storyboard.TargetProperty='ScaleY' To='0.95' Duration='0:0:0.08'/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName='sc' Storyboard.TargetProperty='ScaleX' To='1' Duration='0:0:0.2'/><DoubleAnimation Storyboard.TargetName='sc' Storyboard.TargetProperty='ScaleY' To='1' Duration='0:0:0.2'/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
              <Trigger Property='IsEnabled' Value='False'><Setter TargetName='bd' Property='Opacity' Value='0.4'/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key='Cap' TargetType='Button'>
      <Setter Property='shell:WindowChrome.IsHitTestVisibleInChrome' Value='True'/>
      <Setter Property='Width' Value='34'/>
      <Setter Property='Height' Value='28'/>
      <Setter Property='Margin' Value='0,6,6,0'/>
      <Setter Property='FontFamily' Value='Segoe MDL2 Assets'/>
      <Setter Property='FontSize' Value='11'/>
      <Setter Property='Cursor' Value='Hand'/>
      <Setter Property='Foreground' Value='{DynamicResource Tx}'/>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='Button'>
            <Border x:Name='bd' Background='{DynamicResource Sf2}' BorderBrush='{DynamicResource Bd}' BorderThickness='1' CornerRadius='{DynamicResource RCap}'>
              <ContentPresenter HorizontalAlignment='Center' VerticalAlignment='Center' TextElement.Foreground='{TemplateBinding Foreground}'/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property='IsMouseOver' Value='True'><Setter TargetName='bd' Property='Background' Value='{DynamicResource Hv}'/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key='CapX' TargetType='Button' BasedOn='{StaticResource Cap}'>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='Button'>
            <Border x:Name='bd' Background='{DynamicResource Sf2}' BorderBrush='{DynamicResource Bd}' BorderThickness='1' CornerRadius='{DynamicResource RCap}'>
              <ContentPresenter x:Name='cp' HorizontalAlignment='Center' VerticalAlignment='Center' TextElement.Foreground='{TemplateBinding Foreground}'/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property='IsMouseOver' Value='True'>
                <Setter TargetName='bd' Property='Background' Value='#E5484D'/>
                <Setter TargetName='bd' Property='BorderBrush' Value='#E5484D'/>
                <Setter TargetName='cp' Property='TextElement.Foreground' Value='White'/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key='Fab' TargetType='Button'>
      <Setter Property='Cursor' Value='Hand'/>
      <Setter Property='FocusVisualStyle' Value='{x:Null}'/>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='Button'>
            <Border x:Name='bd' Background='{DynamicResource Sf}' BorderBrush='{DynamicResource CardBd}' BorderThickness='1' CornerRadius='{DynamicResource RFab}' RenderTransformOrigin='0.5,0.5'>
              <Border.RenderTransform><ScaleTransform x:Name='sc'/></Border.RenderTransform>
              <Border.Effect><DropShadowEffect BlurRadius='22' ShadowDepth='4' Opacity='0.35' Color='Black'/></Border.Effect>
              <ContentPresenter HorizontalAlignment='Center' VerticalAlignment='Center'/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property='IsMouseOver' Value='True'>
                <Setter TargetName='bd' Property='BorderBrush' Value='{DynamicResource Ac}'/>
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName='sc' Storyboard.TargetProperty='ScaleX' To='1.1' Duration='0:0:0.12'/><DoubleAnimation Storyboard.TargetName='sc' Storyboard.TargetProperty='ScaleY' To='1.1' Duration='0:0:0.12'/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName='sc' Storyboard.TargetProperty='ScaleX' To='1' Duration='0:0:0.18'/><DoubleAnimation Storyboard.TargetName='sc' Storyboard.TargetProperty='ScaleY' To='1' Duration='0:0:0.18'/></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key='Mini' TargetType='Button'>
      <Setter Property='Width' Value='28'/>
      <Setter Property='Height' Value='28'/>
      <Setter Property='Cursor' Value='Hand'/>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='Button'>
            <Border x:Name='bd' Background='Transparent' CornerRadius='{DynamicResource RSm}'>
              <TextBlock Text='&#xE711;' FontFamily='Segoe MDL2 Assets' FontSize='11' HorizontalAlignment='Center' VerticalAlignment='Center' Foreground='{DynamicResource Dim}'/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property='IsMouseOver' Value='True'><Setter TargetName='bd' Property='Background' Value='{DynamicResource Hv}'/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key='Bare' TargetType='Button'>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='Button'><Ellipse Fill='Transparent'/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key='Nav' TargetType='RadioButton'>
      <Setter Property='Cursor' Value='Hand'/>
      <Setter Property='Foreground' Value='{DynamicResource Dim}'/>
      <Setter Property='FocusVisualStyle' Value='{x:Null}'/>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='RadioButton'>
            <Border x:Name='bd' Background='Transparent' CornerRadius='{DynamicResource RCtl}' Padding='12,10' Margin='0,0,0,4'>
              <ContentPresenter TextElement.Foreground='{TemplateBinding Foreground}'/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property='IsMouseOver' Value='True'>
                <Setter TargetName='bd' Property='Background' Value='{DynamicResource Hv}'/>
                <Setter Property='Foreground' Value='{DynamicResource Tx}'/>
              </Trigger>
              <Trigger Property='IsChecked' Value='True'>
                <Setter TargetName='bd' Property='Background' Value='{DynamicResource AcSoft}'/>
                <Setter Property='Foreground' Value='{DynamicResource Ac}'/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key='Seg' TargetType='RadioButton'>
      <Setter Property='Cursor' Value='Hand'/>
      <Setter Property='Foreground' Value='{DynamicResource Tx}'/>
      <Setter Property='FocusVisualStyle' Value='{x:Null}'/>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='RadioButton'>
            <Border x:Name='bd' Background='{DynamicResource Sf2}' BorderBrush='{DynamicResource Bd}' BorderThickness='1' CornerRadius='{DynamicResource RSm}' Padding='14,7' Margin='0,0,8,0'>
              <ContentPresenter HorizontalAlignment='Center' TextElement.Foreground='{TemplateBinding Foreground}'/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property='IsMouseOver' Value='True'><Setter TargetName='bd' Property='Background' Value='{DynamicResource Hv}'/></Trigger>
              <Trigger Property='IsChecked' Value='True'>
                <Setter TargetName='bd' Property='Background' Value='{DynamicResource Ac}'/>
                <Setter TargetName='bd' Property='BorderBrush' Value='{DynamicResource Ac}'/>
                <Setter Property='Foreground' Value='{DynamicResource AcFg}'/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key='Swatch' TargetType='RadioButton'>
      <Setter Property='Cursor' Value='Hand'/>
      <Setter Property='Width' Value='32'/>
      <Setter Property='Height' Value='32'/>
      <Setter Property='Margin' Value='0,0,8,8'/>
      <Setter Property='FocusVisualStyle' Value='{x:Null}'/>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='RadioButton'>
            <Grid>
              <Ellipse x:Name='ring' Stroke='Transparent' StrokeThickness='2'/>
              <Ellipse Fill='{TemplateBinding Background}' Margin='5'/>
              <TextBlock x:Name='ck' Text='&#xE73E;' FontFamily='Segoe MDL2 Assets' FontSize='11' Foreground='White' HorizontalAlignment='Center' VerticalAlignment='Center' Visibility='Collapsed'/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property='IsMouseOver' Value='True'><Setter TargetName='ring' Property='Stroke' Value='{DynamicResource Bd}'/></Trigger>
              <Trigger Property='IsChecked' Value='True'>
                <Setter TargetName='ring' Property='Stroke' Value='{DynamicResource Tx}'/>
                <Setter TargetName='ck' Property='Visibility' Value='Visible'/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key='Switch' TargetType='ToggleButton'>
      <Setter Property='Cursor' Value='Hand'/>
      <Setter Property='Width' Value='46'/>
      <Setter Property='Height' Value='26'/>
      <Setter Property='FocusVisualStyle' Value='{x:Null}'/>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='ToggleButton'>
            <Grid>
              <Border x:Name='track' CornerRadius='{DynamicResource RTrack}' Background='{DynamicResource Hv}' BorderBrush='{DynamicResource Bd}' BorderThickness='1'/>
              <Border x:Name='thumb' Width='18' Height='18' CornerRadius='{DynamicResource RThumb}' Background='{DynamicResource Dim}' HorizontalAlignment='Left' Margin='4,0,0,0'/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property='IsChecked' Value='True'>
                <Setter TargetName='track' Property='Background' Value='{DynamicResource Ac}'/>
                <Setter TargetName='track' Property='BorderBrush' Value='{DynamicResource Ac}'/>
                <Setter TargetName='thumb' Property='Background' Value='{DynamicResource AcFg}'/>
                <Trigger.EnterActions>
                  <BeginStoryboard><Storyboard><ThicknessAnimation Storyboard.TargetName='thumb' Storyboard.TargetProperty='Margin' To='24,0,0,0' Duration='0:0:0.14'/></Storyboard></BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard><Storyboard><ThicknessAnimation Storyboard.TargetName='thumb' Storyboard.TargetProperty='Margin' To='4,0,0,0' Duration='0:0:0.14'/></Storyboard></BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key='StratCard' TargetType='RadioButton'>
      <Setter Property='Cursor' Value='Hand'/>
      <Setter Property='FocusVisualStyle' Value='{x:Null}'/>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='RadioButton'>
            <Border x:Name='bd' Background='{DynamicResource CardBg}' BorderBrush='{DynamicResource CardBd}' BorderThickness='1' CornerRadius='{DynamicResource RCard}' Padding='16,12' Margin='0,0,0,8'>
              <Grid>
                <ContentPresenter/>
                <TextBlock x:Name='ck' Text='&#xE73E;' FontFamily='Segoe MDL2 Assets' FontSize='16' Foreground='{DynamicResource Ac}' HorizontalAlignment='Right' VerticalAlignment='Center' Visibility='Collapsed'/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property='IsMouseOver' Value='True'><Setter TargetName='bd' Property='Background' Value='{DynamicResource Hv}'/></Trigger>
              <Trigger Property='IsChecked' Value='True'>
                <Setter TargetName='bd' Property='Background' Value='{DynamicResource AcSoft}'/>
                <Setter TargetName='bd' Property='BorderBrush' Value='{DynamicResource Ac}'/>
                <Setter TargetName='ck' Property='Visibility' Value='Visible'/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key='TB' TargetType='TextBox'>
      <Setter Property='Foreground' Value='{DynamicResource Tx}'/>
      <Setter Property='CaretBrush' Value='{DynamicResource Tx}'/>
      <Setter Property='SelectionBrush' Value='{DynamicResource Ac}'/>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='TextBox'>
            <Border x:Name='bd' Background='{DynamicResource Sf2}' BorderBrush='{DynamicResource Bd}' BorderThickness='1' CornerRadius='{DynamicResource RCtl}' Padding='10,8'>
              <ScrollViewer x:Name='PART_ContentHost' Focusable='False' HorizontalScrollBarVisibility='Hidden' VerticalScrollBarVisibility='{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}'/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property='IsKeyboardFocused' Value='True'><Setter TargetName='bd' Property='BorderBrush' Value='{DynamicResource Ac}'/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key='SBThumb' TargetType='Thumb'>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='Thumb'><Border Background='{DynamicResource Dim}' Opacity='0.45' CornerRadius='4' Margin='2,0'/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key='SBPage' TargetType='RepeatButton'>
      <Setter Property='Focusable' Value='False'/>
      <Setter Property='IsTabStop' Value='False'/>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='RepeatButton'><Border Background='Transparent'/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType='ScrollBar'>
      <Setter Property='Width' Value='10'/>
      <Setter Property='Template'>
        <Setter.Value>
          <ControlTemplate TargetType='ScrollBar'>
            <Grid Background='Transparent'>
              <Track x:Name='PART_Track' IsDirectionReversed='True'>
                <Track.DecreaseRepeatButton><RepeatButton Style='{StaticResource SBPage}' Command='ScrollBar.PageUpCommand'/></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style='{StaticResource SBThumb}'/></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Style='{StaticResource SBPage}' Command='ScrollBar.PageDownCommand'/></Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name='Root'>
  <Grid x:Name='AuroraLayer' IsHitTestVisible='False' ClipToBounds='True'>
    <Ellipse x:Name='Blob1' Width='560' Height='560' HorizontalAlignment='Left' VerticalAlignment='Top' Margin='-160,-200,0,0'/>
    <Ellipse x:Name='Blob2' Width='620' Height='620' HorizontalAlignment='Right' VerticalAlignment='Bottom' Margin='0,0,-200,-240'/>
    <Ellipse x:Name='Blob3' Width='480' Height='480' HorizontalAlignment='Left' VerticalAlignment='Bottom' Margin='260,0,0,-260'/>
  </Grid>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width='232'/>
      <ColumnDefinition Width='*'/>
    </Grid.ColumnDefinitions>

    <!-- ===== Sidebar ===== -->
    <Border Grid.Column='0' Background='{DynamicResource SideBg}' BorderBrush='{DynamicResource Bd}' BorderThickness='0,0,1,0'>
      <DockPanel>
        <StackPanel DockPanel.Dock='Top' Orientation='Horizontal' Margin='20,12,0,0'>
          <Border Width='36' Height='36' CornerRadius='{DynamicResource RCtl}' Background='{DynamicResource Ac}'>
            <TextBlock Text='&#xE72E;' FontFamily='Segoe MDL2 Assets' FontSize='17' Foreground='{DynamicResource AcFg}' HorizontalAlignment='Center' VerticalAlignment='Center'/>
          </Border>
          <StackPanel Margin='12,0,0,0' VerticalAlignment='Center'>
            <TextBlock Text='LimixProtocol' FontWeight='Bold' FontSize='15'/>
            <TextBlock Text='v1.1' FontSize='11' Foreground='{DynamicResource Dim}'/>
          </StackPanel>
        </StackPanel>

        <Border DockPanel.Dock='Bottom' Style='{StaticResource Card}' Margin='14' Padding='12,10' Background='{DynamicResource Sf2}'>
          <StackPanel Orientation='Horizontal'>
            <Ellipse x:Name='SideDot' Width='9' Height='9' Fill='{DynamicResource Dim}' VerticalAlignment='Center'/>
            <TextBlock x:Name='SideState' Margin='10,0,0,0' FontWeight='SemiBold' VerticalAlignment='Center'/>
          </StackPanel>
        </Border>

        <StackPanel Margin='12,28,12,0'>
          <RadioButton x:Name='NavHome' GroupName='nav' IsChecked='True' Style='{StaticResource Nav}'>
            <StackPanel Orientation='Horizontal'><TextBlock Text='&#xE80F;' FontFamily='Segoe MDL2 Assets' FontSize='16' Width='30' VerticalAlignment='Center'/><TextBlock Tag='nav.home' FontWeight='SemiBold' VerticalAlignment='Center'/></StackPanel>
          </RadioButton>
          <RadioButton x:Name='NavServices' GroupName='nav' Style='{StaticResource Nav}'>
            <StackPanel Orientation='Horizontal'><TextBlock Text='&#xE71D;' FontFamily='Segoe MDL2 Assets' FontSize='16' Width='30' VerticalAlignment='Center'/><TextBlock Tag='nav.services' FontWeight='SemiBold' VerticalAlignment='Center'/></StackPanel>
          </RadioButton>
          <RadioButton x:Name='NavDomains' GroupName='nav' Style='{StaticResource Nav}'>
            <StackPanel Orientation='Horizontal'><TextBlock Text='&#xE774;' FontFamily='Segoe MDL2 Assets' FontSize='16' Width='30' VerticalAlignment='Center'/><TextBlock Tag='nav.domains' FontWeight='SemiBold' VerticalAlignment='Center'/></StackPanel>
          </RadioButton>
          <RadioButton x:Name='NavStrategies' GroupName='nav' Style='{StaticResource Nav}'>
            <StackPanel Orientation='Horizontal'><TextBlock Text='&#xE945;' FontFamily='Segoe MDL2 Assets' FontSize='16' Width='30' VerticalAlignment='Center'/><TextBlock Tag='nav.strategies' FontWeight='SemiBold' VerticalAlignment='Center'/></StackPanel>
          </RadioButton>
          <RadioButton x:Name='NavHealth' GroupName='nav' Style='{StaticResource Nav}'>
            <StackPanel Orientation='Horizontal'><TextBlock Text='&#xE895;' FontFamily='Segoe MDL2 Assets' FontSize='16' Width='30' VerticalAlignment='Center'/><TextBlock Tag='nav.health' FontWeight='SemiBold' VerticalAlignment='Center'/></StackPanel>
          </RadioButton>
          <RadioButton x:Name='NavLogs' GroupName='nav' Style='{StaticResource Nav}'>
            <StackPanel Orientation='Horizontal'><TextBlock Text='&#xE8A5;' FontFamily='Segoe MDL2 Assets' FontSize='16' Width='30' VerticalAlignment='Center'/><TextBlock Tag='nav.logs' FontWeight='SemiBold' VerticalAlignment='Center'/></StackPanel>
          </RadioButton>
          <RadioButton x:Name='NavSettings' GroupName='nav' Style='{StaticResource Nav}'>
            <StackPanel Orientation='Horizontal'><TextBlock Text='&#xE713;' FontFamily='Segoe MDL2 Assets' FontSize='16' Width='30' VerticalAlignment='Center'/><TextBlock Tag='nav.settings' FontWeight='SemiBold' VerticalAlignment='Center'/></StackPanel>
          </RadioButton>
          <RadioButton x:Name='NavAbout' GroupName='nav' Style='{StaticResource Nav}'>
            <StackPanel Orientation='Horizontal'><TextBlock Text='&#xE946;' FontFamily='Segoe MDL2 Assets' FontSize='16' Width='30' VerticalAlignment='Center'/><TextBlock Tag='nav.about' FontWeight='SemiBold' VerticalAlignment='Center'/></StackPanel>
          </RadioButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===== Content ===== -->
    <Grid Grid.Column='1'>
      <Grid.RowDefinitions>
        <RowDefinition Height='40'/>
        <RowDefinition Height='*'/>
      </Grid.RowDefinitions>

      <StackPanel Orientation='Horizontal' HorizontalAlignment='Right' VerticalAlignment='Top' Margin='0,0,10,0'>
        <Button x:Name='BtnPin' Style='{StaticResource Cap}' Content='&#xE718;'/>
        <Button x:Name='BtnMin' Style='{StaticResource Cap}' Content='&#xE921;'/>
        <Button x:Name='BtnClose' Style='{StaticResource CapX}' Content='&#xE8BB;'/>
      </StackPanel>

      <Grid Grid.Row='1'>

        <!-- HOME -->
        <ScrollViewer x:Name='PgHome' VerticalScrollBarVisibility='Auto'>
          <StackPanel Margin='32,0,32,76'>
            <Grid Width='240' Height='240' HorizontalAlignment='Center' Margin='0,6,0,6'>
              <Ellipse x:Name='BurstRing' Width='172' Height='172' Stroke='{DynamicResource Ac}' StrokeThickness='3' Opacity='0'/>
              <Ellipse x:Name='PulseRing' Width='172' Height='172' Stroke='{DynamicResource Ac}' StrokeThickness='2' Opacity='0'/>
              <Ellipse x:Name='PowerRing' Width='172' Height='172' Fill='{DynamicResource CardBg}' Stroke='{DynamicResource Bd}' StrokeThickness='3'/>
              <TextBlock x:Name='PowerGlyph' Text='&#xE7E8;' FontFamily='Segoe MDL2 Assets' FontSize='64' Foreground='{DynamicResource Dim}' HorizontalAlignment='Center' VerticalAlignment='Center'/>
              <Button x:Name='PowerBtn' Style='{StaticResource Bare}' Width='172' Height='172' Cursor='Hand'/>
            </Grid>
            <TextBlock x:Name='StateTitle' FontSize='26' FontWeight='SemiBold' HorizontalAlignment='Center'/>
            <TextBlock x:Name='StateHint' Foreground='{DynamicResource Dim}' HorizontalAlignment='Center' Margin='0,6,0,26'/>
            <UniformGrid Columns='4'>
              <Border Style='{StaticResource Card}' Margin='0,0,10,0' Padding='14'>
                <StackPanel><TextBlock Tag='home.strategy' FontSize='12' Foreground='{DynamicResource Dim}'/><TextBlock x:Name='StatStrat' FontSize='15' FontWeight='SemiBold' Margin='0,6,0,0' TextTrimming='CharacterEllipsis'/></StackPanel>
              </Border>
              <Border Style='{StaticResource Card}' Margin='0,0,10,0' Padding='14'>
                <StackPanel><TextBlock Tag='home.uptime' FontSize='12' Foreground='{DynamicResource Dim}'/><TextBlock x:Name='StatUptime' FontSize='15' FontWeight='SemiBold' Margin='0,6,0,0'/></StackPanel>
              </Border>
              <Border Style='{StaticResource Card}' Margin='0,0,10,0' Padding='14'>
                <StackPanel><TextBlock Tag='home.services' FontSize='12' Foreground='{DynamicResource Dim}'/><TextBlock x:Name='StatSvc' FontSize='15' FontWeight='SemiBold' Margin='0,6,0,0'/></StackPanel>
              </Border>
              <Border Style='{StaticResource Card}' Padding='14'>
                <StackPanel><TextBlock Tag='home.autostart' FontSize='12' Foreground='{DynamicResource Dim}'/><TextBlock x:Name='StatAuto' FontSize='15' FontWeight='SemiBold' Margin='0,6,0,0'/></StackPanel>
              </Border>
            </UniformGrid>
            <Grid Margin='0,24,0,10'>
              <TextBlock Tag='home.status' FontWeight='SemiBold' FontSize='15' VerticalAlignment='Center'/>
              <Button x:Name='ChipsBtn' Style='{StaticResource Btn}' Tag='home.check' HorizontalAlignment='Right'/>
            </Grid>
            <WrapPanel x:Name='SvcChips'/>
          </StackPanel>
        </ScrollViewer>

        <!-- SERVICES -->
        <ScrollViewer x:Name='PgServices' Visibility='Collapsed' VerticalScrollBarVisibility='Auto'>
          <StackPanel Margin='32,0,32,76'>
            <TextBlock Tag='svc.title' Style='{StaticResource H1}'/>
            <TextBlock Tag='svc.sub' Style='{StaticResource Sub}' Margin='0,4,0,8'/>
            <TextBlock Tag='svc.note' Style='{StaticResource Hint}' Margin='0,0,0,16'/>
            <StackPanel Orientation='Horizontal' Margin='0,0,0,16'>
              <Button x:Name='SvcAll' Style='{StaticResource Btn}' Tag='svc.all' Margin='0,0,8,0'/>
              <Button x:Name='SvcNone' Style='{StaticResource Btn}' Tag='svc.none'/>
            </StackPanel>
            <WrapPanel x:Name='SvcPanel'/>
          </StackPanel>
        </ScrollViewer>

        <!-- DOMAINS -->
        <ScrollViewer x:Name='PgDomains' Visibility='Collapsed' VerticalScrollBarVisibility='Auto'>
          <StackPanel Margin='32,0,32,76'>
            <TextBlock Tag='dom.title' Style='{StaticResource H1}'/>
            <TextBlock Tag='dom.sub' Style='{StaticResource Sub}'/>
            <StackPanel Orientation='Horizontal' Margin='0,0,0,16'>
              <Button x:Name='DomImport' Style='{StaticResource Btn}' Tag='dom.import' Margin='0,0,8,0'/>
              <Button x:Name='DomExport' Style='{StaticResource Btn}' Tag='dom.export' Margin='0,0,8,0'/>
              <Button x:Name='DomFolder' Style='{StaticResource Btn}' Tag='dom.folder'/>
            </StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width='*'/><ColumnDefinition Width='14'/><ColumnDefinition Width='*'/></Grid.ColumnDefinitions>
              <Border Grid.Column='0' Style='{StaticResource Card}'>
                <StackPanel>
                  <TextBlock Tag='dom.custom' FontWeight='SemiBold' FontSize='15'/>
                  <TextBlock Tag='dom.custom.d' Style='{StaticResource Hint}' Margin='0,2,0,12'/>
                  <Grid Margin='0,0,0,12'>
                    <Grid.ColumnDefinitions><ColumnDefinition Width='*'/><ColumnDefinition Width='Auto'/></Grid.ColumnDefinitions>
                    <TextBox x:Name='CustIn' Style='{StaticResource TB}' Margin='0,0,8,0'/>
                    <Button x:Name='CustAdd' Grid.Column='1' Style='{StaticResource BtnP}' Tag='dom.add'/>
                  </Grid>
                  <StackPanel x:Name='CustList'/>
                </StackPanel>
              </Border>
              <Border Grid.Column='2' Style='{StaticResource Card}'>
                <StackPanel>
                  <TextBlock Tag='dom.excl' FontWeight='SemiBold' FontSize='15'/>
                  <TextBlock Tag='dom.excl.d' Style='{StaticResource Hint}' Margin='0,2,0,12'/>
                  <Grid Margin='0,0,0,12'>
                    <Grid.ColumnDefinitions><ColumnDefinition Width='*'/><ColumnDefinition Width='Auto'/></Grid.ColumnDefinitions>
                    <TextBox x:Name='ExclIn' Style='{StaticResource TB}' Margin='0,0,8,0'/>
                    <Button x:Name='ExclAdd' Grid.Column='1' Style='{StaticResource Btn}' Tag='dom.add'/>
                  </Grid>
                  <StackPanel x:Name='ExclList'/>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <!-- STRATEGIES -->
        <ScrollViewer x:Name='PgStrategies' Visibility='Collapsed' VerticalScrollBarVisibility='Auto'>
          <StackPanel Margin='32,0,32,76'>
            <TextBlock Tag='str.title' Style='{StaticResource H1}'/>
            <TextBlock Tag='str.sub' Style='{StaticResource Sub}'/>
            <StackPanel Orientation='Horizontal' Margin='0,0,0,12'>
              <Button x:Name='AutoBtn' Style='{StaticResource BtnP}' Tag='str.auto' Margin='0,0,8,0'/>
              <Button x:Name='ApplyBest' Style='{StaticResource Btn}' Tag='str.apply' Visibility='Collapsed'/>
            </StackPanel>
            <Border Height='6' CornerRadius='{DynamicResource RBar}' Background='{DynamicResource Hv}' Margin='0,0,0,8'>
              <Border x:Name='ProgFill' CornerRadius='{DynamicResource RBar}' Background='{DynamicResource Ac}' RenderTransformOrigin='0,0.5'>
                <Border.RenderTransform><ScaleTransform ScaleX='0'/></Border.RenderTransform>
              </Border>
            </Border>
            <TextBlock x:Name='TestStatus' Foreground='{DynamicResource Dim}' Margin='0,0,0,6' TextWrapping='Wrap'/>
            <StackPanel x:Name='TestResults' Margin='0,0,0,14'/>
            <StackPanel x:Name='StratPanel'/>
          </StackPanel>
        </ScrollViewer>

        <!-- HEALTH -->
        <ScrollViewer x:Name='PgHealth' Visibility='Collapsed' VerticalScrollBarVisibility='Auto'>
          <StackPanel Margin='32,0,32,76'>
            <TextBlock Tag='health.title' Style='{StaticResource H1}'/>
            <TextBlock Tag='health.sub' Style='{StaticResource Sub}'/>
            <WrapPanel Margin='0,0,0,12'>
              <Button x:Name='HealthRun' Style='{StaticResource BtnP}' Tag='health.run' Margin='0,0,8,8'/>
              <Button x:Name='HealthCopy' Style='{StaticResource Btn}' Tag='health.copy' Margin='0,0,8,8'/>
              <Button x:Name='HealthIssue' Style='{StaticResource Btn}' Tag='health.issue' Margin='0,0,8,8'/>
              <Button x:Name='HealthAv' Style='{StaticResource Btn}' Tag='health.av' Margin='0,0,8,8'/>
            </WrapPanel>
            <TextBlock x:Name='HealthStatus' Tag='health.idle' Foreground='{DynamicResource Dim}' Margin='0,0,0,14' TextWrapping='Wrap'/>
            <StackPanel x:Name='HealthList'/>
          </StackPanel>
        </ScrollViewer>

        <!-- LOGS -->
        <Grid x:Name='PgLogs' Visibility='Collapsed' Margin='32,0,32,76'>
          <Grid.RowDefinitions><RowDefinition Height='Auto'/><RowDefinition Height='*'/></Grid.RowDefinitions>
          <Grid Margin='0,0,0,14'>
            <Grid.ColumnDefinitions><ColumnDefinition Width='*'/><ColumnDefinition Width='Auto'/></Grid.ColumnDefinitions>
            <TextBlock Tag='log.title' Style='{StaticResource H1}'/>
            <StackPanel Grid.Column='1' Orientation='Horizontal'>
              <Button x:Name='LogCopy' Style='{StaticResource Btn}' Tag='log.copy' Margin='0,0,8,0'/>
              <Button x:Name='LogClear' Style='{StaticResource Btn}' Tag='log.clear'/>
            </StackPanel>
          </Grid>
          <TextBox x:Name='LogBox' Grid.Row='1' Style='{StaticResource TB}' IsReadOnly='True' FontFamily='Consolas' FontSize='12' TextWrapping='Wrap' AcceptsReturn='True' VerticalScrollBarVisibility='Auto'/>
        </Grid>

        <!-- SETTINGS -->
        <ScrollViewer x:Name='PgSettings' Visibility='Collapsed' VerticalScrollBarVisibility='Auto'>
          <StackPanel Margin='32,0,32,76'>
            <TextBlock Tag='set.title' Style='{StaticResource H1}' Margin='0,0,0,18'/>

            <Border Style='{StaticResource Card}' Margin='0,0,0,14'>
              <StackPanel>
                <TextBlock Tag='set.appearance' Style='{StaticResource Sec}'/>
                <TextBlock Tag='set.theme' FontWeight='SemiBold' Margin='0,10,0,8'/>
                <StackPanel Orientation='Horizontal'>
                  <RadioButton x:Name='ThSystem' GroupName='theme' Style='{StaticResource Seg}'><TextBlock Tag='th.system'/></RadioButton>
                  <RadioButton x:Name='ThDark' GroupName='theme' Style='{StaticResource Seg}'><TextBlock Tag='th.dark'/></RadioButton>
                  <RadioButton x:Name='ThLight' GroupName='theme' Style='{StaticResource Seg}'><TextBlock Tag='th.light'/></RadioButton>
                </StackPanel>
                <TextBlock Tag='set.accent' FontWeight='SemiBold' Margin='0,16,0,8'/>
                <WrapPanel x:Name='SwatchPanel'/>
                <TextBlock Tag='set.lang' FontWeight='SemiBold' Margin='0,8,0,8'/>
                <StackPanel Orientation='Horizontal'>
                  <RadioButton x:Name='LgRu' GroupName='lang' Style='{StaticResource Seg}' Content='Русский'/>
                  <RadioButton x:Name='LgEn' GroupName='lang' Style='{StaticResource Seg}' Content='English'/>
                </StackPanel>
                <TextBlock Tag='set.fx' FontWeight='SemiBold' Margin='0,16,0,8'/>
                <StackPanel Orientation='Horizontal'>
                  <RadioButton x:Name='FxOff' GroupName='fx' Style='{StaticResource Seg}'><TextBlock Tag='fx.off'/></RadioButton>
                  <RadioButton x:Name='FxSoft' GroupName='fx' Style='{StaticResource Seg}'><TextBlock Tag='fx.soft'/></RadioButton>
                  <RadioButton x:Name='FxStrong' GroupName='fx' Style='{StaticResource Seg}'><TextBlock Tag='fx.strong'/></RadioButton>
                </StackPanel>
                <TextBlock Tag='set.corners' FontWeight='SemiBold' Margin='0,16,0,8'/>
                <StackPanel Orientation='Horizontal'>
                  <RadioButton x:Name='CrSharp' GroupName='cr' Style='{StaticResource Seg}'><TextBlock Tag='cr.sharp'/></RadioButton>
                  <RadioButton x:Name='CrSoft' GroupName='cr' Style='{StaticResource Seg}'><TextBlock Tag='cr.soft'/></RadioButton>
                  <RadioButton x:Name='CrRound' GroupName='cr' Style='{StaticResource Seg}'><TextBlock Tag='cr.round'/></RadioButton>
                </StackPanel>
                <Grid Margin='0,14,0,0'>
                  <Grid.ColumnDefinitions><ColumnDefinition Width='*'/><ColumnDefinition Width='Auto'/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Tag='set.anim' FontWeight='SemiBold'/><TextBlock Tag='set.anim.d' Style='{StaticResource Hint}'/></StackPanel>
                  <ToggleButton x:Name='SwAnim' Grid.Column='1' Style='{StaticResource Switch}'/>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style='{StaticResource Card}' Margin='0,0,0,14'>
              <StackPanel>
                <TextBlock Tag='set.startup' Style='{StaticResource Sec}'/>
                <Grid Margin='0,12,0,0'>
                  <Grid.ColumnDefinitions><ColumnDefinition Width='*'/><ColumnDefinition Width='Auto'/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Tag='set.autostart' FontWeight='SemiBold'/><TextBlock Tag='set.autostart.d' Style='{StaticResource Hint}'/></StackPanel>
                  <ToggleButton x:Name='SwAuto' Grid.Column='1' Style='{StaticResource Switch}'/>
                </Grid>
                <Grid Margin='0,14,0,0'>
                  <Grid.ColumnDefinitions><ColumnDefinition Width='*'/><ColumnDefinition Width='Auto'/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Tag='set.autoconn' FontWeight='SemiBold'/><TextBlock Tag='set.autoconn.d' Style='{StaticResource Hint}'/></StackPanel>
                  <ToggleButton x:Name='SwConn' Grid.Column='1' Style='{StaticResource Switch}'/>
                </Grid>
                <Grid Margin='0,14,0,0'>
                  <Grid.ColumnDefinitions><ColumnDefinition Width='*'/><ColumnDefinition Width='Auto'/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Tag='set.tray' FontWeight='SemiBold'/><TextBlock Tag='set.tray.d' Style='{StaticResource Hint}'/></StackPanel>
                  <ToggleButton x:Name='SwTray' Grid.Column='1' Style='{StaticResource Switch}'/>
                </Grid>
                <Grid Margin='0,14,0,0'>
                  <Grid.ColumnDefinitions><ColumnDefinition Width='*'/><ColumnDefinition Width='Auto'/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Tag='set.closetray' FontWeight='SemiBold'/></StackPanel>
                  <ToggleButton x:Name='SwClose' Grid.Column='1' Style='{StaticResource Switch}'/>
                </Grid>
                <Grid Margin='0,14,0,0'>
                  <Grid.ColumnDefinitions><ColumnDefinition Width='*'/><ColumnDefinition Width='Auto'/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Tag='set.promo' FontWeight='SemiBold'/><TextBlock Tag='set.promo.d' Style='{StaticResource Hint}'/></StackPanel>
                  <ToggleButton x:Name='SwPromo' Grid.Column='1' Style='{StaticResource Switch}'/>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style='{StaticResource Card}' Margin='0,0,0,14'>
              <StackPanel>
                <TextBlock Tag='set.engine' Style='{StaticResource Sec}'/>
                <Grid Margin='0,12,0,0'>
                  <Grid.ColumnDefinitions><ColumnDefinition Width='*'/><ColumnDefinition Width='Auto'/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Tag='set.ip' FontWeight='SemiBold'/><TextBlock Tag='set.ip.d' Style='{StaticResource Hint}'/></StackPanel>
                  <ToggleButton x:Name='SwIp' Grid.Column='1' Style='{StaticResource Switch}'/>
                </Grid>
                <Grid Margin='0,14,0,0'>
                  <Grid.ColumnDefinitions><ColumnDefinition Width='*'/><ColumnDefinition Width='Auto'/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Tag='set.watch' FontWeight='SemiBold'/><TextBlock Tag='set.watch.d' Style='{StaticResource Hint}'/></StackPanel>
                  <ToggleButton x:Name='SwWatch' Grid.Column='1' Style='{StaticResource Switch}'/>
                </Grid>
                <Grid Margin='0,14,0,0'>
                  <Grid.ColumnDefinitions><ColumnDefinition Width='*'/><ColumnDefinition Width='Auto'/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Tag='set.heal' FontWeight='SemiBold'/><TextBlock Tag='set.heal.d' Style='{StaticResource Hint}'/></StackPanel>
                  <ToggleButton x:Name='SwHeal' Grid.Column='1' Style='{StaticResource Switch}'/>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style='{StaticResource Card}' Margin='0,0,0,14'>
              <StackPanel>
                <TextBlock Tag='set.security' Style='{StaticResource Sec}'/>
                <Grid Margin='0,12,0,0'>
                  <Grid.ColumnDefinitions><ColumnDefinition Width='*'/><ColumnDefinition Width='Auto'/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Tag='set.verify' FontWeight='SemiBold'/><TextBlock Tag='set.verify.d' Style='{StaticResource Hint}'/></StackPanel>
                  <ToggleButton x:Name='SwVerify' Grid.Column='1' Style='{StaticResource Switch}'/>
                </Grid>
                <TextBlock x:Name='HashStatus' FontWeight='SemiBold' Margin='0,14,0,4'/>
                <TextBlock x:Name='HashInfo' FontFamily='Consolas' FontSize='11' Foreground='{DynamicResource Dim}' Margin='0,0,0,10'/>
                <Button x:Name='PinBtn' Style='{StaticResource Btn}' Tag='set.pin' HorizontalAlignment='Left'/>
              </StackPanel>
            </Border>

            <Border Style='{StaticResource Card}'>
              <StackPanel>
                <TextBlock Tag='set.tools' Style='{StaticResource Sec}'/>
                <WrapPanel Margin='0,12,0,0'>
                  <Button x:Name='DiagBtn' Style='{StaticResource Btn}' Tag='set.diag' Margin='0,0,8,8'/>
                  <Button x:Name='DnsBtn' Style='{StaticResource Btn}' Tag='set.dns' Margin='0,0,8,8'/>
                  <Button x:Name='DrvBtn' Style='{StaticResource Btn}' Tag='set.driver' Margin='0,0,8,8'/>
                  <Button x:Name='FolderBtn' Style='{StaticResource Btn}' Tag='set.folder' Margin='0,0,8,8'/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ABOUT -->
        <ScrollViewer x:Name='PgAbout' Visibility='Collapsed' VerticalScrollBarVisibility='Auto'>
          <StackPanel Margin='32,0,32,76'>
            <TextBlock Tag='nav.about' Style='{StaticResource H1}' Margin='0,0,0,18'/>
            <Border Style='{StaticResource Card}'>
              <StackPanel>
                <TextBlock Text='LimixProtocol 1.1' FontSize='18' FontWeight='Bold'/>
                <TextBlock Tag='about.body' TextWrapping='Wrap' LineHeight='21' Margin='0,12,0,0'/>
                <WrapPanel Margin='0,18,0,0'>
                  <Button x:Name='AboutGh' Style='{StaticResource BtnP}' Tag='about.gh' Margin='0,0,8,8'/>
                  <Button x:Name='AboutRel' Style='{StaticResource Btn}' Tag='about.rel' Margin='0,0,8,8'/>
                  <Button x:Name='UpdBtn' Style='{StaticResource Btn}' Tag='about.upd' Margin='0,0,8,8'/>
                </WrapPanel>
                <TextBlock x:Name='UpdText' Foreground='{DynamicResource Dim}' TextWrapping='Wrap'/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

      </Grid>
    </Grid>
  </Grid>
  <Grid x:Name='Overlay'>
    <Border x:Name='Toast' HorizontalAlignment='Right' VerticalAlignment='Bottom' Margin='0,0,24,86' Width='340' Padding='14' Visibility='Collapsed'
            Background='{DynamicResource Sf}' BorderBrush='{DynamicResource CardBd}' BorderThickness='1' CornerRadius='{DynamicResource RCard}'>
      <Border.Effect><DropShadowEffect BlurRadius='30' ShadowDepth='8' Opacity='0.4' Color='Black'/></Border.Effect>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width='Auto'/><ColumnDefinition Width='*'/></Grid.ColumnDefinitions>
        <Border Width='40' Height='40' VerticalAlignment='Top' CornerRadius='{DynamicResource RCtl}' Background='{DynamicResource AcSoft}'>
          <Path x:Name='ToastLogo' Width='22' Height='22' Stretch='Uniform' Fill='{DynamicResource Ac}'/>
        </Border>
        <StackPanel Grid.Column='1' Margin='12,0,18,0'>
          <TextBlock Tag='promo.title' FontWeight='SemiBold'/>
          <TextBlock Tag='promo.body' Style='{StaticResource Hint}' Margin='0,3,0,10'/>
          <WrapPanel>
            <Button x:Name='ToastOpen' Style='{StaticResource BtnP}' Tag='promo.open' Margin='0,0,8,6'/>
            <Button x:Name='ToastOff' Style='{StaticResource Btn}' Tag='promo.off' Margin='0,0,0,6'/>
          </WrapPanel>
        </StackPanel>
        <Button x:Name='ToastClose' Grid.Column='1' Style='{StaticResource Mini}' HorizontalAlignment='Right' VerticalAlignment='Top' Margin='0,-6,-8,0'/>
      </Grid>
    </Border>
    <Button x:Name='GhBtn' Style='{StaticResource Fab}' Width='48' Height='48' HorizontalAlignment='Right' VerticalAlignment='Bottom' Margin='0,0,24,22'>
      <Path x:Name='GhLogo' Width='24' Height='24' Stretch='Uniform' Fill='{DynamicResource Tx}'/>
    </Button>
  </Grid>
  </Grid>
</Window>
